# Copia este archivo como ".env.local" (sin ".example") y pega ahí tus datos reales.
# ".env.local" nunca se sube a internet ni se comparte: se queda solo en tu computadora
# y, más adelante, en la configuración privada de Vercel.

# Token secreto de tu integración de Notion (notion.so/my-integrations).
# Empieza con "ntn_" o "secret_". NUNCA lo pegues en el código ni lo compartas.
NOTION_TOKEN=

# ID de la base de datos "Content Database" (se saca de su URL en Notion).
NOTION_CALENDAR_DATABASE_ID=e7dfd789d6ab4a8b8f79c91b16fad05c

# Datos del perfil que se muestran arriba del widget (edítalos como quieras, no requieren programar).
NEXT_PUBLIC_PROFILE_HANDLE=@tumarca
NEXT_PUBLIC_PROFILE_BIO=Tu descripción aquí
NEXT_PUBLIC_PROFILE_AVATAR_URL=https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=200&q=80&auto=format&fit=crop
